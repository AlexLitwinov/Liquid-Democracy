# R session artifacts
.Rproj.user
.Rhistory
.RData
.Ruserdata
# renv library (packages are restored via renv::restore(), not committed)
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/sandbox/
renv/staging/
# Simulation output — binary data files and knitr figures (regenerated by re-running simulations)
simulations/output/*.rds
simulations/output/figures/
# Auto-generated simulation notebook output (source .Rmd is tracked, not the rendered .md)
simulations/*.md
# run_cached() simulation cache (regenerated by re-running the .Rmd reports)
data/*.rds
# stray default-device plot file left behind by ad-hoc R sessions
Rplots.pdf
reports/Rplots.pdf
# knitr cache
*_cache/
chunk_outputs/
.secrets
